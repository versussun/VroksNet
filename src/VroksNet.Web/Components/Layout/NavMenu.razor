@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VroksNet</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="specifications">
                <span class="bi bi-file-earmark-text-fill" aria-hidden="true"></span> Specifications
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="test-scenarios">
                <span class="bi bi-send-fill" aria-hidden="true"></span> Test Scenarios
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="publishers">
                <span class="bi bi-broadcast" aria-hidden="true"></span> Publishers
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="call-history">
                <span class="bi bi-clock-history" aria-hidden="true"></span> Call History
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-fill" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
    </nav>

    <button type="button" class="theme-toggle" @onclick="ToggleThemeAsync">
        <span aria-hidden="true">@(_isDark ? "☀️" : "🌙")</span> @(_isDark ? "Light mode" : "Dark mode")
    </button>
</div>

@code {
    private bool _isDark;

    // index.html's inline script already set data-bs-theme before Blazor even booted (avoids a
    // flash of the wrong theme) — this just reads that back so the button's own label/icon starts
    // in sync with it, rather than assuming light.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JS.InvokeAsync<string>("vroksnetTheme.get");
            _isDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("vroksnetTheme.set", _isDark ? "dark" : "light");
    }
}
