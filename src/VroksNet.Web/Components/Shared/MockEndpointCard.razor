@using System.Text.RegularExpressions
@inject SpecificationApiClient SpecificationApi
@inject NavigationManager Navigation

<div class="card mb-3" role="region" aria-label="@Endpoint.OperationKey">
    <div class="card-header d-flex justify-content-between align-items-center">
        <code>@Endpoint.OperationKey</code>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(_isEnabled ? "bg-success" : "bg-secondary")">
                @(_isEnabled ? "Enabled" : "Disabled")
            </span>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="CreateTest">+ Create test</button>
        </div>
    </div>

    <div class="card-body">
        @if (Endpoint.ExampleTemplate is not null)
        {
            <p class="fw-semibold mb-1">Example from spec</p>
            <pre class="@(IsHttpOperation ? "mb-1" : "mb-3")"><code>@Endpoint.ExampleTemplate</code></pre>
            @if (IsHttpOperation)
            {
                <p class="form-text mb-3">
                    The example is a template: <code>{{request.path.&lt;name&gt;}}</code>, <code>{{request.query.&lt;name&gt;}}</code>,
                    <code>{{request.header.&lt;name&gt;}}</code>, <code>{{request.body.&lt;jsonpath&gt;}}</code>, <code>{{uuid}}</code> and
                    <code>{{now}}</code> are filled in from each request. Placeholders that can't be filled in show up as warnings in Call History.
                </p>
            }
        }
        else
        {
            <p class="text-muted fst-italic">No example in the spec for this operation.</p>
        }

        @if (!_isEnabled && IsHttpOperation)
        {
            <p class="text-muted fst-italic">This endpoint is disabled — sending a request to it will return 404.</p>
        }

        @if (!IsHttpOperation)
        {
            <p class="text-muted fst-italic mb-0">AsyncAPI operations aren't invoked here — publish them to a broker from <a href="publishers">Publishers</a> (on a schedule or on demand), or once from a Test Scenario.</p>
        }
        else
        {
            <div class="form-check form-switch mb-2">
                @* Re-keyed after a failed change, for the same reason as the provider switch below. *@
                <input @key="_enabledSwitchVersion" class="form-check-input" type="checkbox" role="switch" id="@($"enabled-{Endpoint.Id}")"
                       checked="@_isEnabled" disabled="@_isTogglingEnabled" @onchange="ToggleEnabledAsync"
                       aria-describedby="@($"enabled-help-{Endpoint.Id}")" />
                <label class="form-check-label" for="@($"enabled-{Endpoint.Id}")">Mock enabled</label>
                <div id="@($"enabled-help-{Endpoint.Id}")" class="form-text">
                    When off, this operation answers 404 — under <code>/mock</code> and on the provider port alike.
                </div>
                @if (_enabledError is not null)
                {
                    <div class="text-danger small" role="alert">@_enabledError</div>
                }
            </div>

            <div class="form-check form-switch mb-2">
                @* Re-keyed after a refused change: the browser already ticked the box, and re-rendering the
                   same "false" wouldn't be seen as a change, so the element is recreated instead (and
                   focus put back on it). *@
                <input @key="_providerSwitchVersion" @ref="_providerSwitch" class="form-check-input" type="checkbox" role="switch" id="@($"provider-mode-{Endpoint.Id}")"
                       checked="@_serveAtRealPath" disabled="@(_isTogglingProvider || Provider?.Enabled != true)" @onchange="ToggleProviderModeAsync"
                       aria-describedby="@($"provider-mode-help-{Endpoint.Id}")" />
                <label class="form-check-label" for="@($"provider-mode-{Endpoint.Id}")">Serve at real path</label>
                <div id="@($"provider-mode-help-{Endpoint.Id}")" class="form-text">
                    @if (Provider?.Enabled != true)
                    {
                        <text>Provider mode isn't configured on this server (set <code>Provider__Port</code>), so operations can't be served at their real path.</text>
                    }
                    else
                    {
                        <text>Also answer on the provider port without the <code>/mock</code> prefix: </text>
                        <code>@Method @ProviderBase@PathTemplate</code>
                        <text>. Point the service under test there; request bodies are checked against the spec (see Call History).</text>
                        @if (Provider.CorsOrigins is { Length: > 0 } origins)
                        {
                            <text> Browsers may call it from @(origins is ["*"] ? "any origin" : string.Join(", ", origins)).</text>
                        }
                        else
                        {
                            <text> CORS is off there, so a browser front end can't call it (set <code>Provider__CorsOrigins</code>).</text>
                        }
                    }
                </div>
                @if (_providerError is not null)
                {
                    <div class="text-danger small" role="alert">@_providerError</div>
                }
            </div>

            @if (_pathParameters.Count > 0)
            {
                <p class="fw-semibold mb-1">Path parameters</p>
                @foreach (var name in _pathParameters)
                {
                    <div class="input-group input-group-sm mb-2" style="max-width: 320px;">
                        <span class="input-group-text">@name</span>
                        <input class="form-control" value="@_paramValues[name]"
                               @oninput="@(e => OnParamChanged(name, e.Value?.ToString() ?? string.Empty))" />
                    </div>
                }
            }

            <p class="mb-2"><span class="fw-semibold">Request:</span> <code>@Method @ResolvedPath</code></p>

            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SendAsync" disabled="@_isSending">
                @(_isSending ? "Sending…" : "Send")
            </button>

            @if (_responseStatus is not null)
            {
                <div class="mt-3">
                    <p class="mb-1">
                        <span class="fw-semibold">Response</span>
                        <span class="badge @(IsSuccessStatus(_responseStatus.Value) ? "bg-success" : "bg-danger")">@_responseStatus</span>
                    </p>
                    <pre class="mb-0"><code>@_responseBody</code></pre>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MockEndpointDetail Endpoint { get; set; } = null!;

    /// <summary>The specification this endpoint belongs to — carried along to Test Scenarios' "create from here" link, since a MockEndpointDetail on its own doesn't know its parent specification's id.</summary>
    [Parameter, EditorRequired]
    public Guid SpecificationId { get; set; }

    private static readonly Regex PlaceholderPattern = new(@"\{([^}]+)\}", RegexOptions.Compiled);

    private string Method = "GET";
    private string PathTemplate = "/";
    private readonly List<string> _pathParameters = [];
    private readonly Dictionary<string, string> _paramValues = [];
    private bool _isSending;
    private bool _serveAtRealPath;
    private bool _isEnabled;
    private bool _isTogglingEnabled;
    private string? _enabledError;
    private int _enabledSwitchVersion;
    private bool _isTogglingProvider;
    private string? _providerError;
    private int _providerSwitchVersion;
    private bool _refocusProviderSwitch;
    private ElementReference _providerSwitch;
    private MockEndpointDetail? _lastEndpoint;

    /// <summary>Where the provider port is (from GET /api/system/provider) — null while loading or if it couldn't be read.</summary>
    [Parameter]
    public ProviderInfo? Provider { get; set; }

    /// <summary>The provider port's base URL as users should call it: the configured public URL, or just the port when the deployment can't know its own external address (e.g. behind Docker's port mapping).</summary>
    private string ProviderBase => Provider?.PublicUrl ?? $"<provider host>:{Provider?.Port}";
    private int? _responseStatus;
    private string? _responseBody;

    /// <summary>Whether this is an HTTP (OpenAPI) operation — decided by the server (MockEndpointDetail.RequiresHttpConnection), not re-derived from the key here.</summary>
    private bool IsHttpOperation => Endpoint.RequiresHttpConnection;

    private string ResolvedPath
    {
        get
        {
            var path = PathTemplate;
            foreach (var name in _pathParameters)
            {
                path = path.Replace($"{{{name}}}", Uri.EscapeDataString(_paramValues.GetValueOrDefault(name, string.Empty)), StringComparison.Ordinal);
            }

            return path;
        }
    }

    protected override void OnParametersSet()
    {
        // The parent re-sends its (possibly older) Endpoint on every render; only a *new* one — after
        // the page reloaded its details — replaces the state this card has confirmed with the server.
        if (!ReferenceEquals(Endpoint, _lastEndpoint))
        {
            _lastEndpoint = Endpoint;
            _serveAtRealPath = Endpoint.ServeAtRealPath;
            _providerError = null;
            _isEnabled = Endpoint.IsEnabled;
            _enabledError = null;
        }

        var parts = Endpoint.OperationKey.Split(' ', 2);
        Method = parts[0];
        PathTemplate = parts.Length > 1 ? parts[1] : "/";

        _pathParameters.Clear();
        _pathParameters.AddRange(PlaceholderPattern.Matches(PathTemplate).Select(match => match.Groups[1].Value));
        foreach (var name in _pathParameters)
        {
            _paramValues.TryAdd(name, "1");
        }
    }

    private void OnParamChanged(string name, string value) => _paramValues[name] = value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocusProviderSwitch)
        {
            _refocusProviderSwitch = false;
            await _providerSwitch.FocusAsync();
        }
    }

    private async Task ToggleEnabledAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        _isTogglingEnabled = true;
        _enabledError = null;

        try
        {
            _enabledError = await SpecificationApi.SetEndpointEnabledAsync(Endpoint.Id, enabled);
        }
        catch (Exception ex)
        {
            _enabledError = $"Failed to change whether the mock is enabled: {ex.Message}";
        }
        finally
        {
            _isTogglingEnabled = false;
        }

        if (_enabledError is null)
        {
            _isEnabled = enabled;
        }
        else
        {
            _enabledSwitchVersion++;
        }
    }

    /// <summary>The server decides whether it's allowed (overlaps are refused) — on a refusal the switch stays off and shows why.</summary>
    private async Task ToggleProviderModeAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        _isTogglingProvider = true;
        _providerError = null;

        try
        {
            _providerError = await SpecificationApi.SetEndpointProviderModeAsync(Endpoint.Id, enabled);
            if (_providerError is null)
            {
                _serveAtRealPath = enabled;
            }
            else
            {
                _providerSwitchVersion++;
                _refocusProviderSwitch = true;
            }
        }
        catch (Exception ex)
        {
            _providerError = $"Failed to change provider mode: {ex.Message}";
            _providerSwitchVersion++;
            _refocusProviderSwitch = true;
        }
        finally
        {
            _isTogglingProvider = false;
        }
    }

    private async Task SendAsync()
    {
        _isSending = true;
        _responseStatus = null;
        _responseBody = null;

        try
        {
            var response = await SpecificationApi.InvokeMockAsync(Method, ResolvedPath);
            _responseStatus = response.StatusCode;
            _responseBody = response.Body;
        }
        catch (Exception ex)
        {
            _responseStatus = 0;
            _responseBody = ex.Message;
        }
        finally
        {
            _isSending = false;
        }
    }

    private static bool IsSuccessStatus(int status) => status is >= 200 and < 300;

    /// <summary>Sends the browser to Test Scenarios with this specification/operation pre-selected — read back there via [SupplyParameterFromQuery] to open the Add panel already filled in.</summary>
    private void CreateTest() => Navigation.NavigateTo($"test-scenarios?specificationId={SpecificationId}&mockEndpointId={Endpoint.Id}");
}
