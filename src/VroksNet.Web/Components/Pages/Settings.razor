@page "/settings"
@inject ConnectionApiClient ConnectionApi
@inject SystemApiClient SystemApi
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<section class="mb-4">
    <h2>Storage</h2>
    @if (_storageStatus is null)
    {
        <p class="text-muted"><em>Loading...</em></p>
    }
    else if (_storageStatus.IsInMemory)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="status">
            <span aria-hidden="true">⚠️</span>
            <div>
                <strong>In-memory database</strong> — specifications, connections and test scenarios will all be lost the next time the app restarts.
                Set the <code>ConnectionStrings__VroksNetDb</code> environment variable to a file path to persist data across restarts (Docker's own image already does this — see the Dockerfile).
            </div>
        </div>

        <div class="card" style="max-width: 640px;">
            <div class="card-body">
                <h3 class="h6">Switch to persistent storage</h3>
                <p class="text-muted small mb-2">
                    This only builds the value to set — the running app can't reconnect its own database live, so it takes effect
                    the next time the process starts. Set it as an environment variable (or the equivalent key under <code>ConnectionStrings</code> in
                    <code>appsettings.json</code>) and restart.
                </p>

                <label class="form-label mb-1" for="storage-path-input">SQLite file path</label>
                <div class="input-group">
                    <input id="storage-path-input" class="form-control" @bind="_desiredStoragePath" @bind:event="oninput" placeholder="vroksnet.db" />
                </div>

                <p class="fw-semibold small mb-1 mt-3">Environment variable</p>
                <div class="input-group input-group-sm">
                    <code class="form-control bg-body-secondary text-break" style="height:auto;">ConnectionStrings__VroksNetDb=@EnvVarValue</code>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CopyEnvVarValueAsync">@(_copied ? "Copied!" : "Copy")</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success d-flex align-items-start gap-2 mb-0" role="status">
            <span aria-hidden="true">✅</span>
            <div>
                <strong>Persistent database</strong> — data is saved to <code>@_storageStatus.FilePath</code> and survives restarts.
            </div>
        </div>
    }
</section>

<section class="mb-4" aria-labelledby="export-heading">
    <h2 id="export-heading">Export configuration</h2>
    <p class="text-muted">
        Download everything configured here — specifications, connections, Publishers, test scenarios and suites — as a provisioning directory:
        <code>specs/</code> and <code>vroksnet.yaml</code>. Commit it, and mount it at <code>/app/provisioning</code> (or pass it to the Aspire package) to start VroksNet already set up.
    </p>
    <a class="btn btn-outline-primary btn-sm" href="@SystemApi.ExportUrl(inlineValues: false)" download>Export</a>
    <a class="btn btn-outline-secondary btn-sm ms-2" href="@SystemApi.ExportUrl(inlineValues: true)" download
       title="The file then holds credentials — keep it private">Export with connection values</a>
    <div class="form-text">
        By default connection values stay out of the file: each becomes <code>valueFrom: ConnectionStrings:&lt;name&gt;</code>, and the file's header lists the variables to set.
    </div>
</section>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2>Connections</h2>
        <p class="text-muted mb-0">Named connections to external systems — a URL or connection string, depending on the service type.</p>
    </div>
    <button type="button" class="btn btn-primary text-nowrap ms-3" @onclick="OpenAddPanel">+ Add connection</button>
</div>

@if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}

@if (_connections is null)
{
    <p><em>Loading...</em></p>
}
else if (_connections.Length == 0)
{
    <p><em>No connections yet.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Service type</th>
                <th>Value</th>
                <th>Updated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var connection in _connections)
            {
                <tr>
                    <td>@connection.Name<ProvisionedBadge ProvisionedAt="connection.ProvisionedAt" /></td>
                    <td>@connection.ServiceType</td>
                    <td>
                        <code>@(_revealed.Contains(connection.Id) ? connection.Value : Mask(connection.Value))</code>
                        <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="() => ToggleReveal(connection.Id)">
                            @(_revealed.Contains(connection.Id) ? "Hide" : "Show")
                        </button>
                    </td>
                    <td>@connection.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => TestAsync(connection)" disabled="@_testingIds.Contains(connection.Id)">
                            @(_testingIds.Contains(connection.Id) ? "Testing…" : "Test")
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => StartEdit(connection)">Edit</button>
                        <button type="button" class="btn btn-outline-danger btn-sm ms-1" @onclick="() => DeleteAsync(connection)">Delete</button>
                        @if (_testResults.TryGetValue(connection.Id, out var testResult))
                        {
                            <div class="mt-1">
                                <span class="badge @(testResult.Success ? "bg-success" : "bg-danger")">@(testResult.Success ? "OK" : "Failed")</span>
                                <small class="text-muted">@testResult.Message</small>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_isPanelOpen)
{
    <div class="connection-panel-backdrop" @onclick="ClosePanel"></div>
}

<aside class="connection-panel @(_isPanelOpen ? "open" : "")">
    <div class="connection-panel-header">
        <h3 class="h6 mb-0">@(_editingId is null ? "Add connection" : "Edit connection")</h3>
        <button type="button" class="btn-close" aria-label="Close" @onclick="ClosePanel"></button>
    </div>

    <div class="connection-panel-body">
        <div class="mb-2">
            <label class="form-label" for="connection-name-input">Name</label>
            <input id="connection-name-input" class="form-control" @bind="_formName" @bind:event="oninput" placeholder="e.g. Orders RabbitMQ" />
        </div>

        <div class="mb-2">
            <label class="form-label" for="connection-service-type-select">Service type</label>
            <select id="connection-service-type-select" class="form-select" @bind="_formServiceType" @bind:after="() => _formTestResult = null">
                <option value="@ConnectionServiceType.Http">HTTP</option>
                <option value="@ConnectionServiceType.RabbitMq">RabbitMQ</option>
                <option value="@ConnectionServiceType.Nats">NATS</option>
                <option value="@ConnectionServiceType.Kafka">Kafka</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label" for="connection-value-input">@(_formServiceType == ConnectionServiceType.Http ? "URL" : "Connection string")</label>
            <div class="input-group">
                <input id="connection-value-input" type="@(_formValueVisible ? "text" : "password")" class="form-control" @bind="_formValue" @bind:event="oninput" @bind:after="() => _formTestResult = null"
                       placeholder="@ValuePlaceholder" autocomplete="off" />
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _formValueVisible = !_formValueVisible">
                    @(_formValueVisible ? "Hide" : "Show")
                </button>
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="TestFormValueAsync" disabled="@(_isTestingForm || string.IsNullOrWhiteSpace(_formValue))">
                @(_isTestingForm ? "Testing…" : "Test connection")
            </button>
            @if (_formTestResult is not null)
            {
                <div class="mt-1">
                    <span class="badge @(_formTestResult.Success ? "bg-success" : "bg-danger")">@(_formTestResult.Success ? "OK" : "Failed")</span>
                    <small class="text-muted">@_formTestResult.Message</small>
                </div>
            }
        </div>

        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@(_isSaving || !CanSave)">
            @(_isSaving ? "Saving…" : _editingId is null ? "Add" : "Save changes")
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="ClosePanel">Cancel</button>
    </div>
</aside>

@code {
    private StorageStatus? _storageStatus;
    private string _desiredStoragePath = "vroksnet.db";
    private bool _copied;
    private ConnectionSummary[]? _connections;
    private readonly HashSet<Guid> _revealed = [];
    private readonly HashSet<Guid> _testingIds = [];
    private readonly Dictionary<Guid, ConnectionTestResult> _testResults = [];
    private string? errorMessage;
    private bool _isSaving;
    private bool _isPanelOpen;
    private bool _formValueVisible;

    private Guid? _editingId;
    private string _formName = string.Empty;
    private ConnectionServiceType _formServiceType = ConnectionServiceType.Http;
    private string _formValue = string.Empty;
    private bool _isTestingForm;
    private ConnectionTestResult? _formTestResult;

    private bool CanSave => !string.IsNullOrWhiteSpace(_formName) && !string.IsNullOrWhiteSpace(_formValue);

    private string EnvVarValue => $"Data Source={(string.IsNullOrWhiteSpace(_desiredStoragePath) ? "vroksnet.db" : _desiredStoragePath)}";

    private string ValuePlaceholder => _formServiceType switch
    {
        ConnectionServiceType.Http => "https://api.example.com",
        ConnectionServiceType.RabbitMq => "amqp://user:password@host:5672/vhost",
        ConnectionServiceType.Nats => "nats://user:password@host:4222",
        ConnectionServiceType.Kafka => "host:9092,host2:9092 — or bootstrap.servers=host:9092;security.protocol=SASL_SSL;…",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        _storageStatus = await SystemApi.GetStorageStatusAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _connections = await ConnectionApi.GetAllAsync();

    /// <summary>Copies the constructed env var value to the clipboard — a convenience only; nothing here changes the running app's own connection (see the Storage section's own note).</summary>
    private async Task CopyEnvVarValueAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"ConnectionStrings__VroksNetDb={EnvVarValue}");
            _copied = true;
        }
        catch (Exception)
        {
            // Clipboard access can be denied (permissions, non-secure context, etc.) — the value
            // is still shown in the box, so this is a soft failure, not worth surfacing as an error.
            _copied = false;
        }
    }

    private void OpenAddPanel()
    {
        ResetForm();
        errorMessage = null;
        _isPanelOpen = true;
    }

    private void StartEdit(ConnectionSummary connection)
    {
        _editingId = connection.Id;
        _formName = connection.Name;
        _formServiceType = connection.ServiceType;
        _formValue = connection.Value;
        _formValueVisible = false;
        errorMessage = null;
        _isPanelOpen = true;
    }

    private void ClosePanel()
    {
        _isPanelOpen = false;
        ResetForm();
    }

    private void ResetForm()
    {
        _editingId = null;
        _formName = string.Empty;
        _formServiceType = ConnectionServiceType.Http;
        _formValue = string.Empty;
        _formValueVisible = false;
        _formTestResult = null;
    }

    /// <summary>Tests the URL/connection string currently typed in the panel, whether or not it's been saved yet — see TestConnectionValueHandler.</summary>
    private async Task TestFormValueAsync()
    {
        _isTestingForm = true;
        _formTestResult = null;

        try
        {
            _formTestResult = await ConnectionApi.TestValueAsync(_formServiceType, _formValue);
        }
        catch (Exception ex)
        {
            _formTestResult = new ConnectionTestResult(false, ex.Message);
        }
        finally
        {
            _isTestingForm = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _isSaving = true;
        errorMessage = null;

        try
        {
            var ok = _editingId is { } id
                ? await ConnectionApi.UpdateAsync(id, _formName, _formServiceType, _formValue)
                : await CreatedOk();

            if (!ok)
            {
                errorMessage = "That connection no longer exists — it may have been deleted elsewhere.";
            }

            ClosePanel();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save connection: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }

        async Task<bool> CreatedOk()
        {
            await ConnectionApi.CreateAsync(_formName, _formServiceType, _formValue);
            return true;
        }
    }

    private async Task DeleteAsync(ConnectionSummary connection)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete connection '{connection.Name}'?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await ConnectionApi.DeleteAsync(connection.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete connection: {ex.Message}";
        }
    }

    private async Task TestAsync(ConnectionSummary connection)
    {
        _testingIds.Add(connection.Id);
        _testResults.Remove(connection.Id);

        try
        {
            var result = await ConnectionApi.TestAsync(connection.Id);
            if (result is null)
            {
                errorMessage = "That connection no longer exists — it may have been deleted elsewhere.";
                await LoadAsync();
            }
            else
            {
                _testResults[connection.Id] = result;
            }
        }
        catch (Exception ex)
        {
            _testResults[connection.Id] = new ConnectionTestResult(false, ex.Message);
        }
        finally
        {
            _testingIds.Remove(connection.Id);
        }
    }

    private void ToggleReveal(Guid id)
    {
        if (!_revealed.Add(id))
        {
            _revealed.Remove(id);
        }
    }

    private static string Mask(string value) => value.Length == 0 ? string.Empty : new string('•', Math.Min(value.Length, 24));
}
