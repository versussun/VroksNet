@page "/test-scenarios"
@inject TestScenarioApiClient TestScenarioApi
@inject SpecificationApiClient SpecificationApi
@inject ConnectionApiClient ConnectionApi
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Test Scenarios</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1>Test Scenarios</h1>
        <p class="text-muted mb-0">Pick a message from an imported specification and send it to a connection — an HTTP service, or a RabbitMQ/NATS/Kafka broker.</p>
    </div>
    <button type="button" class="btn btn-primary text-nowrap ms-3" @onclick="OpenAddPanel">+ Add test scenario</button>
</div>

@if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}

@if (_scenarios is null)
{
    <p><em>Loading...</em></p>
}
else if (_scenarios.Length == 0)
{
    <p><em>No test scenarios yet.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Specification</th>
                <th>Operation</th>
                <th>Connection</th>
                <th>Updated</th>
                <th>Last run</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var scenario in _scenarios)
            {
                <tr>
                    <td>@scenario.Name<ProvisionedBadge ProvisionedAt="scenario.ProvisionedAt" /></td>
                    <td>@scenario.SpecificationTitle</td>
                    <td>
                        <code>@scenario.OperationKey</code>
                        @if (scenario.Kind == TestScenarioKind.Listen)
                        {
                            <span class="badge bg-info text-dark ms-1">Listen</span>
                        }
                    </td>
                    <td>@scenario.ConnectionName (@scenario.ConnectionServiceType)</td>
                    <td>@scenario.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        @if (scenario.LastRunAt is null)
                        {
                            <span class="text-muted">Never run</span>
                        }
                        else
                        {
                            <span class="badge @(scenario.LastRunSuccess == true ? "bg-success" : "bg-danger")">@(scenario.LastRunSuccess == true ? "OK" : "Failed")</span>
                            <br />
                            <small class="text-muted">@scenario.LastRunAt.Value.ToLocalTime().ToString("g")</small>
                        }
                    </td>
                    <td>
                        @if (_running.ContainsKey(scenario.Id) || _backgroundRuns.ContainsKey(scenario.Id))
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled>
                                @(scenario.Kind == TestScenarioKind.Listen ? "Listening…" : "Running…")@(_backgroundRuns.ContainsKey(scenario.Id) ? " (background)" : "")
                            </button>
                            <button type="button" class="btn btn-outline-warning btn-sm ms-1" @onclick="() => StopAsync(scenario)">Stop</button>
                        }
                        else
                        {
                            @if (!RequiresBackgroundRun(scenario))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => RunAsync(scenario)">Run</button>
                            }
                            <button type="button" class="btn btn-outline-primary btn-sm @(RequiresBackgroundRun(scenario) ? "" : "ms-1")"
                                    title="Runs on the server; you can leave the page and come back to its history." @onclick="() => RunInBackgroundAsync(scenario)">Run in background</button>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-1" aria-expanded="@_histories.ContainsKey(scenario.Id)" @onclick="() => ToggleHistoryAsync(scenario)">History</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => StartEditAsync(scenario)">Edit</button>
                        <button type="button" class="btn btn-outline-danger btn-sm ms-1" @onclick="() => DeleteAsync(scenario)">Delete</button>
                        @if (_runResults.TryGetValue(scenario.Id, out var runResult))
                        {
                            <div class="mt-1">
                                <span class="badge @(runResult.Success ? "bg-success" : "bg-danger")">@(runResult.Success ? "OK" : "Failed")</span>
                                <small class="text-muted">@runResult.Message</small>
                                @if (runResult.ContractValidation is { } contract)
                                {
                                    <div class="mt-1" role="status" aria-label="Contract check">
                                        <span class="badge @(contract.IsValid ? "bg-success" : "bg-warning text-dark")">@(contract.IsValid ? "Matches spec" : "Contract violated")</span>
                                        @if (!contract.IsValid)
                                        {
                                            <ul class="small text-danger mb-0 mt-1">
                                                @foreach (var error in contract.Errors ?? [])
                                                {
                                                    <li>@error</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(runResult.ResponseBody))
                                {
                                    <pre class="mt-1 mb-0"><code>@runResult.ResponseBody</code></pre>
                                }
                            </div>
                        }
                    </td>
                </tr>
                @if (_histories.TryGetValue(scenario.Id, out var history))
                {
                    <tr class="table-light">
                        <td colspan="7">
                            @if (history.Length == 0)
                            {
                                <span class="text-muted small">No runs yet.</span>
                            }
                            else
                            {
                                <table class="table table-sm mb-0" aria-label="Run history of @scenario.Name">
                                    <thead>
                                        <tr><th>Status</th><th>Started</th><th>Duration</th><th>Result</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var run in history)
                                        {
                                            <tr>
                                                <td><span class="badge @StatusBadge(run.Status)">@run.Status</span></td>
                                                <td>@((run.StartedAt ?? run.ScheduledFor).ToLocalTime().ToString("g"))</td>
                                                <td>@Duration(run)</td>
                                                <td class="small">@run.Message</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <small class="text-muted">The last @HistoryLength runs. Their traffic is on the <a href="call-history">Call History</a> page.</small>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@if (_isPanelOpen)
{
    <div class="scenario-panel-backdrop" @onclick="ClosePanel"></div>
}

<aside class="scenario-panel @(_isPanelOpen ? "open" : "")">
    <div class="scenario-panel-header">
        <h3 class="h6 mb-0">@(_editingId is null ? "Add test scenario" : "Edit test scenario")</h3>
        <button type="button" class="btn-close" aria-label="Close" @onclick="ClosePanel"></button>
    </div>

    <div class="scenario-panel-body">
        <div class="mb-2">
            <label class="form-label" for="scenario-name-input">Name</label>
            <input id="scenario-name-input" class="form-control" @bind="_formName" @bind:event="oninput" placeholder="e.g. Send order-created to Orders API" />
        </div>

        <div class="mb-2">
            <label class="form-label" for="scenario-spec-select">Specification</label>
            <select id="scenario-spec-select" class="form-select" @bind="_formSpecificationId" @bind:after="OnSpecificationChangedAsync">
                <option value="">Select a specification…</option>
                @if (_specifications is not null)
                {
                    @foreach (var spec in _specifications)
                    {
                        <option value="@spec.Id">@spec.Title (@spec.Kind)</option>
                    }
                }
            </select>
        </div>

        <div class="mb-2">
            <label class="form-label" for="scenario-operation-select">Operation</label>
            <select id="scenario-operation-select" class="form-select" @bind="_formMockEndpointId" @bind:after="OnOperationChanged" disabled="@(_specificationEndpoints is null)">
                <option value="">Select an operation…</option>
                @if (_specificationEndpoints is not null)
                {
                    @foreach (var endpoint in _specificationEndpoints)
                    {
                        <option value="@endpoint.Id">@endpoint.OperationKey</option>
                    }
                }
            </select>
        </div>

        <div class="mb-2">
            <label class="form-label" for="scenario-connection-select">Connection</label>
            <select id="scenario-connection-select" class="form-select" @bind="_formConnectionId">
                <option value="">Select a connection…</option>
                @foreach (var connection in CompatibleConnections)
                {
                    <option value="@connection.Id">@connection.Name (@connection.ServiceType)</option>
                }
            </select>
            @if (SelectedEndpoint is not null && _connections is { Length: > 0 } && !CompatibleConnections.Any())
            {
                <div class="form-text text-danger">No @(SelectedEndpoint.RequiresHttpConnection ? "Http" : "RabbitMq/Nats/Kafka") connections yet — add one on the Settings page first.</div>
            }
        </div>

        @if (CanChooseMode)
        {
            <div class="mb-2">
                <label class="form-label" for="scenario-kind-select">Mode</label>
                <select id="scenario-kind-select" class="form-select" @bind="_formKind">
                    <option value="@TestScenarioKind.Send">Publish a message to the channel</option>
                    <option value="@TestScenarioKind.Listen">Listen for a message and validate it</option>
                </select>
            </div>
        }

        @if (IsListening)
        {
            <div class="mb-2">
                <label class="form-label" for="scenario-timeout-input">Wait up to (seconds)</label>
                <input id="scenario-timeout-input" type="number" min="1" max="@MaxListenTimeoutSeconds" class="form-control @(IsListenTimeoutValid ? "" : "is-invalid")"
                       @bind="_formListenTimeoutText" @bind:event="oninput" placeholder="30" aria-describedby="scenario-timeout-help" />
                <div id="scenario-timeout-help" class="@(IsListenTimeoutValid ? "form-text" : "invalid-feedback")">
                    A whole number from 1 to @MaxListenTimeoutSeconds (30 minutes). Leave blank for 30. Longer than @MaxSynchronousListenSeconds runs only in the background.
                </div>
            </div>
        }

        @if (SelectedConnection?.ServiceType == ConnectionServiceType.RabbitMq)
        {
            <div class="mb-3">
                <label class="form-label" for="scenario-exchange-input">Exchange</label>
                <input id="scenario-exchange-input" class="form-control" @bind="_formExchange" @bind:event="oninput"
                       placeholder="@(IsListening ? DefaultExchange : "(default exchange)")" aria-describedby="scenario-exchange-help" />
                <div id="scenario-exchange-help" class="form-text">
                    @if (IsListening)
                    {
                        <text>A temporary queue is bound to this exchange with the channel address as binding key, so the service's own consumers still get every message. Blank means @DefaultExchange.</text>
                    }
                    else
                    {
                        <text>Published here with the channel address as routing key — a Listen scenario on the same exchange hears it. Blank publishes straight into the queue named after the channel (the default exchange).</text>
                    }
                </div>
            </div>
        }

        @if (!IsListening)
        {
            <div class="mb-3">
                <label class="form-label" for="scenario-payload-textarea">Payload (optional override)</label>
                <textarea id="scenario-payload-textarea" class="form-control" rows="4" @bind="_formPayloadOverride" @bind:event="oninput"
                          placeholder="Leave blank to send the operation's own example from the spec"></textarea>
            </div>
        }

        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@(_isSaving || !CanSave)">
            @(_isSaving ? "Saving…" : _editingId is null ? "Add" : "Save changes")
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="ClosePanel">Cancel</button>
    </div>
</aside>

@code {
    private TestScenarioSummary[]? _scenarios;
    private SpecificationSummary[]? _specifications;
    private ConnectionSummary[]? _connections;
    private MockEndpointDetail[]? _specificationEndpoints;
    private readonly Dictionary<Guid, CancellationTokenSource> _running = [];
    private readonly Dictionary<Guid, RunTestScenarioResult> _runResults = [];
    /// <summary>Scenario id → its background run being polled.</summary>
    private readonly Dictionary<Guid, Guid> _backgroundRuns = [];
    /// <summary>Scenario id → its run history, for the scenarios whose History is open.</summary>
    private readonly Dictionary<Guid, TestRunSummary[]> _histories = [];
    /// <summary>Stops the polling loops when the page goes away.</summary>
    private readonly CancellationTokenSource _pageCts = new();
    private string? errorMessage;
    private bool _isSaving;
    private bool _isPanelOpen;

    /// <summary>Set by MockEndpointCard's "+ Create test" link (specifications/{id} → /test-scenarios?specificationId=...&amp;mockEndpointId=...) so this page can open the Add panel already pointed at that operation.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "specificationId")]
    public Guid? QuerySpecificationId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "mockEndpointId")]
    public Guid? QueryMockEndpointId { get; set; }

    private Guid? _editingId;
    private string _formName = string.Empty;
    private string _formSpecificationId = string.Empty;
    private string _formMockEndpointId = string.Empty;
    private string _formConnectionId = string.Empty;
    private string _formPayloadOverride = string.Empty;
    private TestScenarioKind _formKind = TestScenarioKind.Send;
    private string _formListenTimeoutText = string.Empty;

    /// <summary>Mirrors the server's TestScenarioListening.MaxTimeoutSeconds, only to give feedback before saving — the server still validates.</summary>
    private const int MaxListenTimeoutSeconds = 1800;

    /// <summary>Mirrors TestScenarioListening.MaxSynchronousTimeoutSeconds: a Listen waiting longer only gets "Run in background".</summary>
    private const int MaxSynchronousListenSeconds = 80;

    private const int HistoryLength = 20;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(1.5);

    /// <summary>Blank means "use the server default"; otherwise a whole number in range.</summary>
    private bool IsListenTimeoutValid => string.IsNullOrWhiteSpace(_formListenTimeoutText)
        || (int.TryParse(_formListenTimeoutText, out var seconds) && seconds is >= 1 and <= MaxListenTimeoutSeconds);

    private int? ListenTimeoutSeconds => int.TryParse(_formListenTimeoutText, out var seconds) ? seconds : null;
    /// <summary>What a new scenario's Exchange starts as, so a new Send and Listen on the same operation meet; the server's default for a blank Listen exchange too.</summary>
    private const string DefaultExchange = "amq.topic";

    private string _formExchange = DefaultExchange;

    /// <summary>The server decides which operations can be listened to (MockEndpointDetail.CanListen).</summary>
    private bool CanChooseMode => SelectedEndpoint?.CanListen == true;

    private bool IsListening => CanChooseMode && _formKind == TestScenarioKind.Listen;

    private ConnectionSummary? SelectedConnection => _connections?.FirstOrDefault(c => c.Id.ToString() == _formConnectionId);

    /// <summary>Starts a newly picked operation in the mode the server suggests for it (see MockEndpointDetail.DefaultTestScenarioKind).</summary>
    private void OnOperationChanged() => _formKind = SelectedEndpoint?.DefaultTestScenarioKind ?? TestScenarioKind.Send;

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_formName)
        && Guid.TryParse(_formSpecificationId, out _)
        && Guid.TryParse(_formMockEndpointId, out _)
        && Guid.TryParse(_formConnectionId, out _)
        && (!IsListening || IsListenTimeoutValid);

    private MockEndpointDetail? SelectedEndpoint => _specificationEndpoints?.FirstOrDefault(e => e.Id.ToString() == _formMockEndpointId);

    /// <summary>Once an operation is picked, only offer connections its OperationKey could actually be sent through — see OperationCompatibility on the server.</summary>
    private IEnumerable<ConnectionSummary> CompatibleConnections =>
        _connections is null ? []
        : SelectedEndpoint is null ? _connections
        : _connections.Where(c => (c.ServiceType == ConnectionServiceType.Http) == SelectedEndpoint.RequiresHttpConnection);

    protected override async Task OnInitializedAsync()
    {
        _specifications = await SpecificationApi.GetAllAsync();
        _connections = await ConnectionApi.GetAllAsync();
        await LoadAsync();

        if (QuerySpecificationId is { } specificationId && _specifications.Any(s => s.Id == specificationId))
        {
            _formSpecificationId = specificationId.ToString();
            await OnSpecificationChangedAsync();

            if (QueryMockEndpointId is { } mockEndpointId && _specificationEndpoints!.Any(e => e.Id == mockEndpointId))
            {
                _formMockEndpointId = mockEndpointId.ToString();
                OnOperationChanged();
            }

            errorMessage = null;
            _isPanelOpen = true;
        }
    }

    private async Task LoadAsync() => _scenarios = await TestScenarioApi.GetAllAsync();

    private async Task OnSpecificationChangedAsync()
    {
        _formMockEndpointId = string.Empty;
        _specificationEndpoints = null;

        if (Guid.TryParse(_formSpecificationId, out var specificationId))
        {
            var details = await SpecificationApi.GetByIdAsync(specificationId);
            _specificationEndpoints = details?.Endpoints ?? [];
        }
    }

    private void OpenAddPanel()
    {
        ResetForm();
        errorMessage = null;
        _isPanelOpen = true;
    }

    private async Task StartEditAsync(TestScenarioSummary scenario)
    {
        _editingId = scenario.Id;
        _formName = scenario.Name;
        _formSpecificationId = scenario.SpecificationId.ToString();
        _formConnectionId = scenario.ConnectionId.ToString();
        _formPayloadOverride = scenario.PayloadOverride ?? string.Empty;
        _formKind = scenario.Kind;
        _formListenTimeoutText = scenario.ListenTimeoutSeconds?.ToString() ?? string.Empty;
        _formExchange = scenario.Exchange ?? string.Empty;
        errorMessage = null;

        await OnSpecificationChangedAsync();
        _formMockEndpointId = scenario.MockEndpointId.ToString();
        _isPanelOpen = true;
    }

    private void ClosePanel()
    {
        _isPanelOpen = false;
        ResetForm();
    }

    private void ResetForm()
    {
        _editingId = null;
        _formName = string.Empty;
        _formSpecificationId = string.Empty;
        _formMockEndpointId = string.Empty;
        _formConnectionId = string.Empty;
        _formPayloadOverride = string.Empty;
        _formKind = TestScenarioKind.Send;
        _formListenTimeoutText = string.Empty;
        _formExchange = DefaultExchange;
        _specificationEndpoints = null;
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _isSaving = true;
        errorMessage = null;

        var listening = IsListening;
        var form = new TestScenarioForm(
            _formName,
            Guid.Parse(_formSpecificationId),
            Guid.Parse(_formMockEndpointId),
            Guid.Parse(_formConnectionId),
            listening || string.IsNullOrWhiteSpace(_formPayloadOverride) ? null : _formPayloadOverride,
            listening ? TestScenarioKind.Listen : TestScenarioKind.Send,
            listening ? ListenTimeoutSeconds : null,
            SelectedConnection?.ServiceType == ConnectionServiceType.RabbitMq && !string.IsNullOrWhiteSpace(_formExchange)
                ? _formExchange
                : null);

        try
        {
            var ok = _editingId is { } id
                ? await TestScenarioApi.UpdateAsync(id, form)
                : await CreatedOk();

            if (!ok)
            {
                errorMessage = "That test scenario no longer exists — it may have been deleted elsewhere.";
            }

            ClosePanel();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save test scenario: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }

        async Task<bool> CreatedOk()
        {
            await TestScenarioApi.CreateAsync(form);
            return true;
        }
    }

    private async Task DeleteAsync(TestScenarioSummary scenario)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete test scenario '{scenario.Name}'?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await TestScenarioApi.DeleteAsync(scenario.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete test scenario: {ex.Message}";
        }
    }

    private async Task RunAsync(TestScenarioSummary scenario)
    {
        var cts = new CancellationTokenSource();
        _running[scenario.Id] = cts;
        _runResults.Remove(scenario.Id);

        try
        {
            var result = await TestScenarioApi.RunAsync(scenario.Id, cts.Token);
            if (result is null)
            {
                errorMessage = "That test scenario no longer exists — it may have been deleted elsewhere.";
            }
            else
            {
                _runResults[scenario.Id] = result;
            }

            // Refreshes the persisted "Last run" column (RunTestScenarioHandler records it
            // server-side) even when the scenario was deleted mid-run.
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
            _runResults[scenario.Id] = new RunTestScenarioResult(false, "Stopped by user.", null);
        }
        catch (Exception ex)
        {
            _runResults[scenario.Id] = new RunTestScenarioResult(false, ex.Message, null);
        }
        finally
        {
            _running.Remove(scenario.Id);
            cts.Dispose();
        }
    }

    /// <summary>
    /// Cancels the in-flight HTTP call. ASP.NET Core binds the request's CancellationToken through
    /// to RunTestScenarioHandler and on into MessageSender.SendAsync / MessageListener.ListenAsync,
    /// so this actually aborts the server-side send or stops the listen wait too — not just the
    /// client's wait for a response.
    /// </summary>
    private async Task StopAsync(TestScenarioSummary scenario)
    {
        if (_running.TryGetValue(scenario.Id, out var cts))
        {
            cts.Cancel();
        }
        else if (_backgroundRuns.TryGetValue(scenario.Id, out var runId))
        {
            // The polling loop picks up the run's final (Cancelled) status.
            await TestScenarioApi.CancelRunAsync(runId);
        }
    }

    private static bool RequiresBackgroundRun(TestScenarioSummary scenario)
        => scenario.Kind == TestScenarioKind.Listen && (scenario.ListenTimeoutSeconds ?? 30) > MaxSynchronousListenSeconds;

    /// <summary>Queues a server-side run, then polls it until it finishes — the run keeps going if this page is left.</summary>
    private async Task RunInBackgroundAsync(TestScenarioSummary scenario)
    {
        _runResults.Remove(scenario.Id);
        try
        {
            var runId = await TestScenarioApi.StartRunAsync(scenario.Id, _pageCts.Token);
            if (runId is null)
            {
                errorMessage = "That test scenario no longer exists — it may have been deleted elsewhere.";
                return;
            }

            _backgroundRuns[scenario.Id] = runId.Value;
            StateHasChanged();

            TestRunSummary? run;
            do
            {
                await Task.Delay(PollInterval, _pageCts.Token);
                run = await TestScenarioApi.GetRunAsync(runId.Value, _pageCts.Token);
            }
            while (run is { IsFinished: false });

            _runResults[scenario.Id] = run?.ToRunResult() ?? new RunTestScenarioResult(false, "The run disappeared from the history.", null);
            await LoadAsync();
            if (_histories.ContainsKey(scenario.Id))
            {
                _histories[scenario.Id] = await TestScenarioApi.GetRunsAsync(scenario.Id, HistoryLength, _pageCts.Token);
            }
        }
        catch (OperationCanceledException) when (_pageCts.IsCancellationRequested)
        {
            // The page went away; the run carries on on the server.
        }
        catch (Exception ex)
        {
            _runResults[scenario.Id] = new RunTestScenarioResult(false, ex.Message, null);
        }
        finally
        {
            _backgroundRuns.Remove(scenario.Id);
        }
    }

    private async Task ToggleHistoryAsync(TestScenarioSummary scenario)
    {
        if (!_histories.Remove(scenario.Id))
        {
            _histories[scenario.Id] = await TestScenarioApi.GetRunsAsync(scenario.Id, HistoryLength, _pageCts.Token);
        }
    }

    private static string StatusBadge(TestRunStatus status) => status switch
    {
        TestRunStatus.Passed => "bg-success",
        TestRunStatus.Failed => "bg-danger",
        TestRunStatus.Running or TestRunStatus.Queued => "bg-primary",
        _ => "bg-secondary"
    };

    private static string Duration(TestRunSummary run)
        => run is { StartedAt: { } started, FinishedAt: { } finished }
            ? (finished - started).TotalSeconds < 60 ? $"{(finished - started).TotalSeconds:0.#}s" : $"{(finished - started).TotalMinutes:0.#}m"
            : "—";

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }
}
