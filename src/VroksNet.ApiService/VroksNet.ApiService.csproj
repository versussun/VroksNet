<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VroksNet.Application\VroksNet.Application.csproj" />
    <ProjectReference Include="..\VroksNet.Infrastructure\VroksNet.Infrastructure.csproj" />
    <ProjectReference Include="..\VroksNet.ServiceDefaults\VroksNet.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
