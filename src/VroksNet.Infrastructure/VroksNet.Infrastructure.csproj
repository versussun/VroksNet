<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VroksNet.Application\VroksNet.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provisioning manifest's schema lives with the docs (the Aspire package's repository
         validates against the same file); FileProvisioningSource reads this embedded copy. -->
    <EmbeddedResource Include="..\..\docs\schemas\provisioning-manifest.v1.schema.json"
                      LogicalName="VroksNet.Infrastructure.Provisioning.provisioning-manifest.v1.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="NATS.Client.Core" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="SharpYaml" />
  </ItemGroup>

</Project>
