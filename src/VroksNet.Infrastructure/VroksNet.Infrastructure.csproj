<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VroksNet.Application\VroksNet.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provisioning manifest's schema lives with the docs (the Aspire package's repository
         validates against the same file); FileProvisioningSource reads this embedded copy. -->
    <EmbeddedResource Include="..\..\docs\schemas\provisioning-manifest.v1.schema.json"
                      LogicalName="VroksNet.Infrastructure.Provisioning.provisioning-manifest.v1.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" />
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="NATS.Client.Core" />
    <!-- .proto parsing (ADR 0004). Aliased: protobuf-net.Reflection declares its own
         Google.Protobuf.Reflection types, which clash with Google.Protobuf's; only
         ProtoSpecificationParser sees them, through "extern alias protobufnet". The alias doesn't
         flow to projects referencing this one, so they don't compile against these packages at all
         (PrivateAssets="compile"); they still get the assemblies at run time. -->
    <PackageReference Include="protobuf-net" Aliases="protobufnet" PrivateAssets="compile" />
    <PackageReference Include="protobuf-net.Reflection" Aliases="protobufnet" PrivateAssets="compile" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="SharpYaml" />
  </ItemGroup>

</Project>
